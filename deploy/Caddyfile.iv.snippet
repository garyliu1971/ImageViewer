# /iv/ ：网页版漫画浏览器（纯静态 PWA），与 /reader/、WebDAV 同域。
#
# 放进站点块里，位置必须在兜底（catch-all，反代到 SFTPGo WebDAV 的那个 handle / reverse_proxy）之前，
# 紧挨着现有的 `handle_path /reader/* { ... }`。不要改动别的块。
#
# 静态目录 = deploy/build_iv_static.py 的输出（index.html + manifest + sw.js + icons），部署到 /var/www/iv。
#
# 注意 1：这里故意不写 `encode`。/iv/ 下的东西很小，没必要压缩；更重要的是 WebDAV（zip / epub 的 Range 读取）
#         那条路径绝不能被压缩，否则 Content-Range / Content-Length 会对不上。如果站点块顶层本来就有
#         `encode gzip zstd`，请把它挪进 /reader/ 这样的 handle 里（或在 WebDAV 的 handle 里排除），
#         见 README-iv-deploy.md 第 6 步的验证命令。
# 注意 2：`/iv`（不带斜杠）不会被 handle_path /iv/* 匹配，所以先补一条跳转。
# 注意 3：读 PDF 用的 pdf.js 放在 /iv/vendor/pdfjs/（同源 module 脚本 + module worker），已经被下面这条 CSP 覆盖，不用改。
#         （JPEG2000 / JPXDecode 图片的解码器也是 WebAssembly，下面加了 'wasm-unsafe-eval' 之后顺带也能显示。）
# 注意 5：读 rar / cbr / 7z / cb7 / tar / cbt / tgz 用 libarchive.js（/iv/vendor/libarchive/，同源 module 脚本 + module worker + 一个 .wasm），
#         WebAssembly 要编译，所以 script-src 必须带 'wasm-unsafe-eval'（只加在这个 /iv/* 块里，/reader/ 等别的块不动）。
#         这是发布 libarchive 支持时唯一要改的一行：把现有 CSP 里的  script-src 'self' 'unsafe-inline';  换成  script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval';
#         .wasm 必须以 application/wasm 发出（Caddy file_server 默认就是）；不加这一项的话 rar / 7z / tar 打不开，提示里会写明要 wasm-unsafe-eval，zip / cbz / epub / pdf 不受影响。
# 注意 4：在线朗读（/iv/ 里的 🔊）从同源的 /tts/v1/speak 取音频，用 <audio> 播放 blob: 地址，所以 CSP 多了 media-src 'self' blob:
#         （没有这一条，默认的 default-src 'self' 会拦掉 blob: 音频）。/tts/ 这个块本身不用动，connect-src 'self' 已经够取音频。

	redir /iv /iv/ 308

	handle_path /iv/* {
		root * /var/www/iv
		# 页面 / service worker / manifest 每次都向服务器确认（304 很便宜），发布后马上生效
		header Cache-Control "no-cache"
		# 同源 WebDAV 上有登录凭据（只读账号）：禁止别的站点把这个页面放进 iframe，不给 Referer
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
		header X-Frame-Options "DENY"
		header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		# sw.js 默认 Service-Worker-Allowed 就是它所在目录（/iv/），不要放宽
		file_server
	}
